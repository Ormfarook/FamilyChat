# Copy to .env for local development. Metro auto-loads .env at bundle time.
#
# Any variable prefixed with EXPO_PUBLIC_ is inlined into the client bundle
# and readable in code as `process.env.EXPO_PUBLIC_XXX`.

# URL of the FamilyChat backend. During local dev this is your laptop's
# backend on http://localhost:4000. For mobile testing over Cloudflare
# quick tunnels, override in the shell before starting Expo, e.g.:
#
#   EXPO_PUBLIC_SERVER_URL=https://xxxx.trycloudflare.com npx expo start
EXPO_PUBLIC_SERVER_URL=http://localhost:4000
